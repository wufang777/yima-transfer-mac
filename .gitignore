# ---- 构建产物（体积大，且可完全由脚本重建）----
build/
dist/
*.spec
!win/yima_win.spec
__pycache__/
*.pyc
*.pyo

# ---- 发布物（走 release.sh 产出，不进代码仓）----
*.dmg
*.pkg

# ---- 运行时数据 ----
config.json
received/
*.log
*连接二维码.png

# ---- 本地备份 / 归档 ----
*.bak
*备份*
installed-backup/
old/

# ---- macOS ----
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp

# Windows 版构建产物
win/build/
win/dist/
win/icon.ico
win/__pycache__/

# ---- 鸿蒙（HarmonyOS）工程 ----
harmony/node_modules/
harmony/oh_modules/
harmony/.hvigor/
harmony/.idea/
harmony/**/build/
harmony/.preview/
harmony/.cxx/

# ---- 安卓工程 ----
android/**/build/
android/.gradle/
android/.idea/
android/.cxx/
android/local.properties

# ---- 签名密钥（绝不入库）----
harmony/signing/
*.p12
*.key
*.csr
*.p7b
*.keystore
*.jks
